# Public Supabase project values. The anon/publishable key is safe to expose only
# because the database migration keeps subscriber data behind Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep Phase Three work hidden until the Supabase migration and project values
# have been added to the deployment environment.
VITE_EMAIL_SIGNUP_ENABLED=false
# Optional for a hosted staging preview. Local development previews automatically.
VITE_EMAIL_SIGNUP_PREVIEW=false

# Store these as Supabase Edge Function secrets, never as Vite variables:
# BREVO_API_KEY
# BREVO_LIST_ID
# BREVO_RESOURCE_LIST_ID
